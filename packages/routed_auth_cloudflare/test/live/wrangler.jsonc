{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "routed-auth-d1-live-conformance",
  "main": "../../build/live_d1_worker.js",
  "compatibility_date": "2026-08-19",
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "REPLACE_WITH_TEMP_DATABASE_NAME",
      "database_id": "REPLACE_WITH_TEMP_DATABASE_ID"
    }
  ]
}
